# --- Effortlessness Analyzer · backend env ---

# Logging
LOG_LEVEL=INFO

# Where uploads land (and from where they're deleted after processing).
UPLOAD_DIR=/tmp/effortlessness_uploads

# Decode FPS — 12 is fast and plenty for AU dynamics. Bump to 24 for max fidelity.
TARGET_FPS=12

# Keep uploads after processing? 0 = delete (default), 1 = keep for inspection.
KEEP_UPLOADS=0

# Maximum upload size (MB).
MAX_UPLOAD_MB=500

# CORS origins (comma-separated). Use the Vite dev origin in dev, your prod origin in prod.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
